# Copy to .env.local and adjust. Every variable is validated at startup by
# src/config/env.ts (fail-fast Zod schema) — that file is the contract;
# add new variables there first.

# Base URL prefixed to every apiFetch path. Empty = same-origin (default).
# Server-side fetching always needs the absolute form.
#NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# The /showcase routes and their demo endpoint. Default "true" (keep during
# development); set "false" in the production build environment to prerender
# them as static 404s. Build-time inlined — changing it requires a rebuild.
#NEXT_PUBLIC_ENABLE_SHOWCASE=false
