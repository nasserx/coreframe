# Copy to .env.local and adjust.
#
# The env contract is deliberately split across two files, and adding a
# variable touches both:
#   - src/config/env-validation.ts — the fail-fast Zod schema, run at startup
#     by next.config.ts. Zod lives HERE and nowhere else in src/config, so it
#     never ships to the client (DECISIONS.md).
#   - src/config/env.ts — the typed values (RAW_ENV + ENV_CONFIG), the contract
#     every consumer reads. No Zod. Do not add a schema here: that would pull
#     ~69 kB gz into every client bundle that reads ENV_CONFIG.
#
# Follow the 4-step checklist in the header comment of src/config/env.ts.

# Base URL prefixed to every apiFetch path. Empty = same-origin (default).
# Server-side fetching always needs the absolute form.
#NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# The /showcase routes and their demo endpoint. Default "true" (keep during
# development); set "false" in the production build environment to prerender
# them as static 404s. Build-time inlined — changing it requires a rebuild.
#NEXT_PUBLIC_ENABLE_SHOWCASE=false
