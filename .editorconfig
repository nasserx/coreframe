# EditorConfig — editor-agnostic baseline that mirrors what this foundation
# enforces elsewhere (Prettier, .gitattributes, .prettierrc.json). It applies
# in the editor as you type, before Prettier runs on save/commit.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: trailing whitespace can be a hard line break, so don't trim it.
[*.md]
trim_trailing_whitespace = false

# Keep the project's line-ending normalization (see .gitattributes) explicit
# for lockfiles and config that some tools rewrite.
[{*.yml,*.yaml,*.json}]
indent_size = 2
